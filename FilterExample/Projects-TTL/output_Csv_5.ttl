<pm:test#Csv_5_regular_org.apache.commons.csv.LexerTest.testCommentsAndEmptyLines> a pm:Test ;
    schema:name "testCommentsAndEmptyLines" ;
    pm:testMethodName "org.apache.commons.csv.LexerTest.testCommentsAndEmptyLines" ;
    pm:fileName "LexerTest.java" ;
    pm:package "org.apache.commons.csv" ;
    pm:testMethodCode "['public void testCommentsAndEmptyLines() throws IOException {', 'final String code =', '\"1,2,3,\\\\n\"+                // 1', '\"\\\\n\"+                      // 1b', '\"\\\\n\"+                      // 1c', '\"a,b x,c#no-comment\\\\n\"+    // 2', '\"#foo\\\\n\"+                  // 3', '\"\\\\n\"+                      // 4', '\"\\\\n\"+                      // 4b', '\"d,e,#no-comment\\\\n\"+       // 5', '\"\\\\n\"+                      // 5b', '\"\\\\n\"+                      // 5c', '\"# penultimate comment\\\\n\"+ // 6', '\"\\\\n\"+                      // 6b', '\"\\\\n\"+                      // 6c', '\"# Final comment\\\\n\";       // 7', \"final CSVFormat format = CSVFormat.DEFAULT.withCommentStart('#').withIgnoreEmptyLines(false);\", 'assertFalse(\"Should not ignore empty lines\", format.getIgnoreEmptyLines());', '', 'final Lexer parser = getLexer(code, format);', '', '', 'assertThat(parser.nextToken(new Token()), matches(TOKEN, \"1\"));', 'assertThat(parser.nextToken(new Token()), matches(TOKEN, \"2\"));', 'assertThat(parser.nextToken(new Token()), matches(TOKEN, \"3\"));', 'assertThat(parser.nextToken(new Token()), matches(EORECORD, \"\"));             // 1', 'assertThat(parser.nextToken(new Token()), matches(EORECORD, \"\"));             // 1b', 'assertThat(parser.nextToken(new Token()), matches(EORECORD, \"\"));             // 1c']" ;
    pm:partOfTestSuite <pm:testsuite#Csv_5_regular> .

