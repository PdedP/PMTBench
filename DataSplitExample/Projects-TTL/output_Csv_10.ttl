    pm:fileName "LexerTest.java" ;
    pm:package "org.apache.commons.csv" ;
    pm:testMethodCode "['public void testNextToken4() throws IOException {', '/* file:  a,\"foo\",b', '*        a,   \" foo\",b', '*        a,\"foo \"   ,b     // whitespace after closing encapsulator', '*        a,  \" foo \" ,b', '*/', 'final String code = \"a,\\\\\"foo\\\\\",b\\\\na,   \\\\\" foo\\\\\",b\\\\na,\\\\\"foo \\\\\"  ,b\\\\na,  \\\\\" foo \\\\\"  ,b\";', 'final Lexer parser = getLexer(code, CSVFormat.DEFAULT.withIgnoreSurroundingSpaces(true));', 'assertThat(parser.nextToken(new Token()), matches(TOKEN, \"a\"));', 'assertThat(parser.nextToken(new Token()), matches(TOKEN, \"foo\"));', 'assertThat(parser.nextToken(new Token()), matches(EORECORD, \"b\"));', 'assertThat(parser.nextToken(new Token()), matches(TOKEN, \"a\"));', 'assertThat(parser.nextToken(new Token()), matches(TOKEN, \" foo\"));', 'assertThat(parser.nextToken(new Token()), matches(EORECORD, \"b\"));', 'assertThat(parser.nextToken(new Token()), matches(TOKEN, \"a\"));']" ;
    pm:partOfTestSuite <pm:testsuite#Csv_10_regular> .

