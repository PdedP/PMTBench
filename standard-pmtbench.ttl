@prefix : <https://b2share.eudat.eu/records/90aa1d6fa6c74a73adc4e0ba64771367/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Definition of class Project and its properties (apart from those given by schema:SoftwareSourceCode)
:Project a rdfs:Class ;
    rdfs:label "Project" ;
    rdfs:comment "A software project. Use either 'version' or 'commit' property. The project identifier should include the project name followed by 'version' or 'commit'" ;
    rdfs:subClassOf schema:SoftwareSourceCode .

# Commit identifier (optional)
:commit a rdfs:Property ;
    rdfs:label "commit" ;
    rdfs:comment "The specific commit identifier (SHA) in the repository" ;
    schema:domainIncludes :Project ;
    schema:rangeIncludes schema:Text .

# Project version (optional)	
:version a rdfs:Property ;
    rdfs:label "version" ;
    rdfs:comment "The specific version downloaded from the repository" ;
    schema:domainIncludes :Project ;
    schema:rangeIncludes schema:Text .

# TTL file for the project 	
:ttlFile a rdfs:Property ;
    rdfs:label "ttlFile" ;
    rdfs:comment "The ttl file containing the data for this [[Project]]" ;
    schema:domainIncludes :Project ;
    schema:rangeIncludes schema:Text .

# ------------------------------------------------------------------------------------------------------------#

# Definition of class File (individual files of a project) and its properties 
:File a rdfs:Class ;
    rdfs:label "File" ;
    rdfs:comment "The original source code file. The file identifier should include the project identifier, followed by the package and the file name" ;
    rdfs:subClassOf schema:SoftwareSourceCode .

# Association between a file and its project
:partOfProject a rdfs:Property ;
    rdfs:label "partOfProject" ;
    rdfs:comment "The [[Project]] to which this file belongs" ;
    schema:domainIncludes :File ;
    schema:rangeIncludes :Project .

# File extension
:extension a rdfs:Property ;
    rdfs:label "extension" ;
    rdfs:comment "The file extension (e.g., 'java', 'py')" ;
    schema:domainIncludes :File ;
    schema:rangeIncludes schema:Text .

# Full file name
:fileName a rdfs:Property ;
    rdfs:label "fileName" ;
    rdfs:comment "The full file name, e.g., [[name]].[[extension]]" ;
    schema:domainIncludes :File ;
    schema:rangeIncludes schema:Text .

# The package to which the file belongs
:package a rdfs:Property ;
    rdfs:label "package" ;
    rdfs:comment "The package to which the file belongs" ;
    schema:domainIncludes :File ;
    schema:rangeIncludes schema:Text .
	
# ------------------------------------------------------------------------------------------------------------#	
	
# Definition of class MutationTool
:MutationTool a rdfs:Class ;
    rdfs:label "MutationTool" ;
    rdfs:comment "The tool used to generate the [[Mutant]]. The identifier should include the tool name and software version" ;
    rdfs:subClassOf schema:SoftwareApplication .
	
# Example of MutationTool:
#
#<pm:MutationTool#ExampleTool_1.0> a :MutationTool ;
#    schema:name "ExampleTool" ;
#    schema:softwareVersion "1.0" ;
#    schema:softwareSetting [
#        a schema:PropertyValue ;
#        schema:name "targetClasses" ;
#        schema:value "com.mycompany.*" ;
#        schema:description "The classes to be mutated."
#    ] .

# ------------------------------------------------------------------------------------------------------------#	
	
# Definition of class Mutant and its properties 
:Mutant a rdfs:Class ;
    rdfs:label "Mutant" ;
    rdfs:comment "A modified version of a [[File]]. The mutant identifier should include the file identifier followed by the line, the operator, the count and the mutation tool identifier" ;
    rdfs:subClassOf schema:SoftwareSourceCode .

# Association between a mutant and its mutant generation tool
:generatedByTool a rdfs:Property ;
    rdfs:label "generatedByTool" ;
    rdfs:comment "The [[MutationTool]] that generated this mutant" ;
    schema:domainIncludes :Mutant ;
    schema:rangeIncludes :MutationTool .

# Association between a mutant and its file
:originalFile a rdfs:Property ;
    rdfs:label "originalFile" ;
    rdfs:comment "The [[File]] that the mutant originates from" ;
    schema:domainIncludes :Mutant ;
    schema:rangeIncludes :File .
	
# Mutation operator	
:operator a rdfs:Property ;
    rdfs:label "operator" ;
    rdfs:comment "The operator needed to get the mutant from the [[File]]" ;
    schema:domainIncludes :Mutant ;
    schema:rangeIncludes schema:Text .
	
# Mutation count 
:count a rdfs:Property ;
    rdfs:label "count" ;
    rdfs:comment "A number used to distinguish multiple mutants generated by the same operator on the same line in [[File]]" ;
    schema:domainIncludes :Mutant ;
    schema:rangeIncludes schema:Number .	

# Mutated line
:line a rdfs:Property ;
    rdfs:label "line" ;
    rdfs:comment "The number of the mutated line in [[File]]" ;
    schema:domainIncludes :Mutant ;
    schema:rangeIncludes schema:Number .
	
# Full name of the mutated method	
:method a rdfs:Property ;
    rdfs:label "method" ;
    rdfs:comment "The full name of the mutated method in [[File]] in the format package.class.method" ;
    schema:domainIncludes :Mutant ;
    schema:rangeIncludes schema:Text .	
	
# Equivalence (optional)
:equivalence a rdfs:Property ;
    rdfs:label "equivalence" ;
    rdfs:comment "If the mutant is equivalent to [[File]] this should be true. If it is not equivalent, it should be false. Otherwise, empty/unknown" ;
    schema:domainIncludes :Mutant ;
    schema:rangeIncludes :Boolean .

# ------------------------------------------------------------------------------------------------------------#		

# Definition of class TestSuite and its properties
:TestSuite a rdfs:Class ;
    rdfs:label "TestSuite" ;
    rdfs:comment "The test suite used in the execution. The test suite identifier should include the project identifier, followed by a unique test suite name" ;
	rdfs:subClassOf schema:SoftwareSourceCode .
	
# Association between a test suite and its project
:partOfProject a rdfs:Property ;
    rdfs:label "partOfProject" ;
    rdfs:comment "The [[Project]] to which this test suite belongs" ;
    schema:domainIncludes :TestSuite ;
    schema:rangeIncludes :Project .

# Test file extension
:extension a rdfs:Property ;
    rdfs:label "extension" ;
    rdfs:comment "The file extension (e.g., 'java', 'py')" ;
    schema:domainIncludes :TestSuite ;
    schema:rangeIncludes schema:Text .

# Full test file name
:fileName a rdfs:Property ;
    rdfs:label "fileName" ;
    rdfs:comment "The full test file name, e.g., [[name]].[[extension]]" ;
    schema:domainIncludes :TestSuite ;
    schema:rangeIncludes schema:Text .

# The package to which the test suite belongs
:package a rdfs:Property ;
    rdfs:label "package" ;
    rdfs:comment "The package to which the test suite belongs" ;
    schema:domainIncludes :TestSuite ;
    schema:rangeIncludes schema:Text .
	
# Tests that were excluded from execution
:excludedTests a rdfs:Property ;
    rdfs:label "excludedTests" ;
    rdfs:comment "A list of specific tests that were excluded from this execution. For example, this can be a package, class name patterns under the excludes tag of the maven-surefire-plugin, or test methods manually excluded in the format package.class.testMethod" ;
    schema:domainIncludes :TestSuite ;
    schema:rangeIncludes schema:Text .

# Test execution filter pattern
:targetTests a rdfs:Property ;
    rdfs:label "targetTests" ;
    rdfs:comment "A pattern indicating the subset of tests that were executed. For example, this can be a package, class name patterns under the includes tag of the maven-surefire-plugin, or test methods manually excluded in the format package.class.testMethod" ;
    schema:domainIncludes :TestSuite ;
    schema:rangeIncludes schema:Text .
	
# Link to newly added test files
:addedTests a rdfs:Property ;
    rdfs:label "addedTests" ;
    rdfs:comment "Link to the repository where the added test files are located" ;
    schema:domainIncludes :TestSuite ;
    schema:rangeIncludes schema:URL .	
	
# ------------------------------------------------------------------------------------------------------------#		

# Definition of class Test and its properties
:Test a rdfs:Class ;
    rdfs:label "Test" ;
    rdfs:comment "A single test case. The test case identifier should include the test suite identifier, followed by the full test case name." ;
	rdfs:subClassOf schema:SoftwareSourceCode .
	
# Association between a test case and its test suite
:partOfTestSuite a rdfs:Property ;
    rdfs:label "partOfTestSuite" ;
    rdfs:comment "The [[TestSuite]] to which this test case belongs" ;
    schema:domainIncludes :Test ;
    schema:rangeIncludes :TestSuite .
	
# Test file extension
:extension a rdfs:Property ;
    rdfs:label "extension" ;
    rdfs:comment "The file extension (e.g., 'java', 'py')" ;
    schema:domainIncludes :Test ;
    schema:rangeIncludes schema:Text .

# Full test file name
:fileName a rdfs:Property ;
    rdfs:label "fileName" ;
    rdfs:comment "The full test file name, e.g., [[name]].[[extension]]" ;
    schema:domainIncludes :Test ;
    schema:rangeIncludes schema:Text .

# The package to which the test case belongs
:package a rdfs:Property ;
    rdfs:label "package" ;
    rdfs:comment "The package to which the test case belongs" ;
    schema:domainIncludes :Test ;
    schema:rangeIncludes schema:Text .	
	
# Full test case name
:testMethodName a rdfs:Property ;
    rdfs:label "testMethodName" ;
    rdfs:comment "The full test case name in the format package.class.testMethod" ;
    schema:domainIncludes :Test ;
    schema:rangeIncludes schema:Text .
	
# Test method code
:testMethodCode a rdfs:Property ;
    rdfs:label "testMethodCode" ;
    rdfs:comment "The lines of code of [[Test]]" ;
    schema:domainIncludes :Test ;
    schema:rangeIncludes schema:Text .

# ------------------------------------------------------------------------------------------------------------#		

# Definition of class CoverageTool 
:CoverageTool a rdfs:Class ;
    rdfs:label "CoverageTool" ;
    rdfs:comment "The tool used to collect the dynamic metrics for [[Execution]]. The identifier should include the tool name and software version" ;
    rdfs:subClassOf schema:SoftwareApplication .

# ------------------------------------------------------------------------------------------------------------#		

# Definition of class Execution (test suite or test cases execution on a mutant) and its properties
:Execution a rdfs:Class ;
    rdfs:label "Execution" ;
    rdfs:comment "Result of test execution on a [[Mutant]]. The execution identifier should include the mutant identifier followed by the test suite identifier" .

# Association between the execution data and the coverage tool
:analyzedByTool a rdfs:Property ;
    rdfs:label "analyzedByTool" ;
    rdfs:comment "The [[CoverageTool] used to obtain the dynamic metrics" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes :CoverageTool .

# Association between the execution data and the executed mutant 
:executedOnMutant a rdfs:Property ;
    rdfs:label "executedOnMutant" ;
    rdfs:comment "The [[Mutant]] that this execution is associated with" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes :Mutant .
	
# Association between the execution data and the executed test suite 
:executedByTestSuite a rdfs:Property ;
    rdfs:label "executedByTestSuite" ;
    rdfs:comment "The [[TestSuite]] that this execution is associated with" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes :TestSuite .
	
# Association between the execution data and the list of executed test cases (optional) 
:executedByTestCases a rdfs:Property ;
    rdfs:label "executedByTestCases" ;
    rdfs:comment "An RDF list of [[Test]] individuals that this execution is associated with, ordered to match related metrics like numExecuteCovered." ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes rdf:List .

# Association between the execution data and the list of killing test cases (optional) 
:killedByTestCases a rdfs:Property ;
    rdfs:label "killedByTestCases" ;
    rdfs:comment "An RDF list of killing [[Test]] individuals that this execution is associated with" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes rdf:List .

# Association between the execution data and the list of surviving test cases (optional) 
:survivedToTestCases a rdfs:Property ;
    rdfs:label "survivedToTestCases" ;
    rdfs:comment "An RDF list of surviving [[Test]] individuals that this execution is associated with" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes rdf:List .	
	
# Mutant status or label after test suite execution
:label a rdfs:Property ;
    rdfs:label "label" ;
    rdfs:comment "The status of the Mutant after test suite execution. Normally, KILLED or SURVIVED" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes schema:Text .

# List of dynamic metrics (new metrics can be added)

# Number of times the mutant is executed by the test suite or each test case.
:numExecuteCovered a rdf:Property ;
    rdfs:label "numExecuteCovered" ;
    rdfs:comment "The number of times the [[Mutant]] is executed either by the whole [[TestSuite]] (a single number) or by each of the [[Test]] individuals (an RDF list of numbers, corresponding to each test case in the property executedByTestCases)" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes schema:Number, rdf:List .

# Number of tests cases in the test suite covering the mutant (only for test suite)
:numTestCovered a rdfs:Property ;
    rdfs:label "numTestCovered" ;
    rdfs:comment "The number of test cases in the [[TestSuite]] covering the [[Mutant]]" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes schema:Number .

# Number of assertions in the test methods covering the mutant
:numMutantAssertion a rdfs:Property ;
    rdfs:label "numMutantAssertion" ;
    rdfs:comment "The number of assertions in the test methods covering the [[Mutant]], either at the [[TestSuite]] level (a single number) or at the [[Test]] level (an RDF list of numbers, corresponding to each test case in the property executedByTestCases)" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes schema:Number, rdf:List .

# Number of assertions in the mutated class's corresponding test class of the test suite (only for test suite)
:numClassAssertion a rdfs:Property ;
    rdfs:label "numClassAssertion" ;
    rdfs:comment "The total number of assertions in the mutated class's corresponding test class of the [[TestSuite]]" ;
    schema:domainIncludes :Execution ;
    schema:rangeIncludes schema:Number .
	
# ------------------------------------------------------------------------------------------------------------#		

# Definition of the class AnalysisTool
:AnalysisTool a rdfs:Class ;
    rdfs:label "AnalysisTool" ;
    rdfs:comment "The tool used to generate static metrics for [[StaticAnalysis]]. The identifier should include the tool name and software version" ;
    rdfs:subClassOf schema:SoftwareApplication .
	
# ------------------------------------------------------------------------------------------------------------#		

# Definition of the class StaticAnalysis
:StaticAnalysis a rdfs:Class ;
    rdfs:label "StaticAnalysis" ;
    rdfs:comment "Static metrics related to a specific [[Mutant]]. The static data identifier should include the mutant identifier (and, optionally, the analysis tool identifier if different tools are used to collect static data)" .

# Association between the static data and its mutant
:analyzedMutant a rdfs:Property ;
    rdfs:label "analyzedMutant" ;
    rdfs:comment "The [[Mutant]] that this static data analysis is associated with" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes :Mutant .

# Analysis tool that generated the static data
:analyzedByTool a rdfs:Property ;
    rdfs:label "analyzedByTool" ;
    rdfs:comment "The [[AnalysisTool]] that generated this static data" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes :AnalysisTool .

# List of static metrics (new metrics can be added)

# McCabe Cyclomatic Complexity
:VG a rdfs:Property ;
    rdfs:label "VG" ;
    rdfs:comment "McCabe Cyclomatic Complexity: the number of unique possible paths through code (method)" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Number .

# Depth of Inheritance Tree
:DIT a rdfs:Property ;
    rdfs:label "DIT" ;
    rdfs:comment "Depth of Inheritance Tree: the maximum depth of the inheritance hierarchy for a class" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Number .

# Nested Block Depth
:NBD a rdfs:Property ;
    rdfs:label "NBD" ;
    rdfs:comment "Nested Block Depth: the maximum depth of the deepest level of nesting within a method" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Number .

# Number of Children
:NOCh a rdfs:Property ;
    rdfs:label "NOCh" ;
    rdfs:comment "Number of Children: the number of classes that directly extend this class" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Number .

# Total Lines of Code
:TLOC a rdfs:Property ;
    rdfs:label "TLOC" ;
    rdfs:comment "Total Lines of Code: the total number of lines of code in the mutated method, ignoring comments and whitespace" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Number .

# Afferent Coupling
:Ca a rdfs:Property ;
    rdfs:label "Ca" ;
    rdfs:comment "Afferent Coupling: the number of classes outside a package that depend on it" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Number .

# Efferent Coupling
:Ce a rdfs:Property ;
    rdfs:label "Ce" ;
    rdfs:comment "Efferent Coupling: the number of classes inside a package that depend on classes outside of it" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Number .

# Instability
:I a rdfs:Property ;
    rdfs:label "I" ;
    rdfs:comment "Instability: Ce/(Ce+Ca), representing the riskiness of a package" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Number .

# Return type of the mutated method
:typeReturn a rdfs:Property ;
    rdfs:label "typeReturn" ;
    rdfs:comment "The return type of the mutated method (type descriptor)" ;
    schema:domainIncludes :StaticAnalysis ;
    schema:rangeIncludes schema:Text .

# ------------------------------------------------------------------------------------------------------------#		

# Definition of class NaturalLanguage
:NaturalLanguage a rdfs:Class ;
    rdfs:label "Natural Language Analysis" ;
    rdfs:comment "Analysis data related to the [[Mutant]]. The natural language identifier should include the mutant identifier" .

# Association between the natural language data and its mutant
:refersToMutant a rdfs:Property ;
    rdfs:label "refersToMutant" ;
    rdfs:comment "The [[Mutant]] that this natural language analysis refers to" ;
    schema:domainIncludes :NaturalLanguage ;
    schema:rangeIncludes :Mutant .

# List of NaturalLanguage features (new features can be added)

# Mutated code in the original file
:srcLines a rdfs:Property ;
    rdfs:label "srcLines" ;
    rdfs:comment "The lines of code of the mutated method in the original [[File]]" ;
    schema:domainIncludes :NaturalLanguage ;
    schema:rangeIncludes schema:Text .

# Modified code in the original file before mutation
:before a rdfs:Property ;
    rdfs:label "before" ;
    rdfs:comment "The modified code in the original [[File]] before mutation" ;
    schema:domainIncludes :NaturalLanguage ;
    schema:rangeIncludes schema:Text .

# Modified code in the mutant
:after a rdfs:Property ;
    rdfs:label "after" ;
    rdfs:comment "The modified code in the [[Mutant]]" ;
    schema:domainIncludes :NaturalLanguage ;
    schema:rangeIncludes schema:Text .